{
  "name": "strip-console",
  "version": "0.0.1",
  "description": "Strip console.* calls from JavaScript and TypeScript code",
  "keywords": [
    "console",
    "strip",
    "remove",
    "console.log",
    "build"
  ],
  "author": "Anurag",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-m-anurag/strip-console.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "pnpm run build",
    "check:pkg": "publint && attw --pack . --profile node16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "cac": "^7.0.0"
  },
  "bin": {
    "strip-console": "./dist/cli.mjs"
  }
}
