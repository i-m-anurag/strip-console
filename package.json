{
  "name": "strip-console",
  "version": "0.2.0",
  "description": "Strip console.* calls from JavaScript and TypeScript code",
  "keywords": [
    "build",
    "console",
    "console.log",
    "esbuild-plugin",
    "remove",
    "rollup-plugin",
    "strip",
    "unplugin",
    "vite-plugin",
    "webpack-plugin"
  ],
  "homepage": "https://github.com/i-m-anurag/strip-console#readme",
  "bugs": {
    "url": "https://github.com/i-m-anurag/strip-console/issues"
  },
  "author": "Anurag",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-m-anurag/strip-console.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/rollup.d.mts",
        "default": "./dist/rollup.mjs"
      },
      "require": {
        "types": "./dist/rollup.d.cts",
        "default": "./dist/rollup.cjs"
      }
    },
    "./rolldown": {
      "import": {
        "types": "./dist/rolldown.d.mts",
        "default": "./dist/rolldown.mjs"
      },
      "require": {
        "types": "./dist/rolldown.d.cts",
        "default": "./dist/rolldown.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.mts",
        "default": "./dist/webpack.mjs"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./rspack": {
      "import": {
        "types": "./dist/rspack.d.mts",
        "default": "./dist/rspack.mjs"
      },
      "require": {
        "types": "./dist/rspack.d.cts",
        "default": "./dist/rspack.cjs"
      }
    },
    "./esbuild": {
      "import": {
        "types": "./dist/esbuild.d.mts",
        "default": "./dist/esbuild.mjs"
      },
      "require": {
        "types": "./dist/esbuild.d.cts",
        "default": "./dist/esbuild.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "pnpm run build",
    "check:pkg": "publint && attw --pack . --profile node16",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@rspack/core": "^2.2.8",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "publint": "^0.3.25",
    "rolldown": "^1.2.12",
    "rollup": "^4.64.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "webpack": "^5.111.1"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "cac": "^7.0.0",
    "magic-string": "^1.4.2",
    "oxc-parser": "^0.152.0",
    "tinyglobby": "^0.2.17",
    "unplugin": "^3.4.0",
    "unplugin-utils": "^0.3.2"
  },
  "bin": {
    "strip-console": "./dist/cli.mjs"
  }
}
